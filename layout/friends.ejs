<article class="article about-page"><h1><%= page.title || px_t('friends') %></h1><div class="content"><%- page.content %></div><div class="friends-grid"><% px_friends().forEach(friend=>{ %><a class="friend-card" href="<%= px_url(friend.url) %>" target="_blank" rel="noopener noreferrer"><% if(friend.avatar){ %><img src="<%= px_url(friend.avatar) %>" alt="" width="64" height="64" loading="lazy"><% } else { %><%- px_icon('link') %><% } %><div><h2><%= friend.name %></h2><p><%= friend.description || '' %></p></div></a><% }); %></div><%- partial('comment') %></article>
