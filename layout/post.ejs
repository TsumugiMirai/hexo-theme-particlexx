<div class="reading-layout"><article class="article reading-card"><header><h1><%= page.title %></h1><% if(is_post()){ %><div class="info"><time datetime="<%= page.date.toISOString() %>"><%= date(page.date,'YYYY-MM-DD') %></time><% if(page.updated){ %> · <%= date(page.updated,'YYYY-MM-DD') %><% } %></div><% } %></header><div class="content"><%- page.content %></div><%- partial('comment') %></article>
<% if(theme.toc.enable && page.toc!==false){ const headings=toc(page.content,{list_number:false}); if(headings){ %><aside class="toc-card"><nav aria-label="<%= px_t('toc') %>"><h2><%= px_t('toc') %></h2><%- headings %></nav></aside><% }} %></div>
