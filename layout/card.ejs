<div id="card-style"><div id="card-div"><div class="avatar"><img src="<%= px_url(theme.avatar) %>" alt="<%= config.author %>" width="140" height="140" loading="lazy" decoding="async"></div><div class="name"><%= config.author %></div><div class="description"><% String(theme.card.description||'').split('\n').forEach(line=>{ %><span class="signature-line"><%= line %></span><% }); %></div>
<div class="icon-links"><% Object.entries(theme.card.iconLinks||{}).forEach(([name,value])=>{ %><span class="icon-link"><a href="<%= px_url(value.link) %>" title="<%= name %>" aria-label="<%= name %>" target="_blank" rel="noopener noreferrer"><% if(value.icon){ %><img class="px-icon" src="<%= px_url(value.icon) %>" alt=""><% } else { %><%- px_icon(value.name) %><% } %></a></span><% }); %></div>
<% if(Object.keys(theme.card.friendLinks||{}).length){ %><div class="friend-links"><div class="links-heading"><%= px_t('friends') %></div><% Object.entries(theme.card.friendLinks).forEach(([name,link])=>{ %><div class="friend-link"><a href="<%= px_url(link) %>" target="_blank" rel="noopener noreferrer"><%= name %></a></div><% }); %></div><% } %>
</div></div>
