<% if(page.comments!==false && theme.comments.provider!=='none'){ const c=theme.comments; const key=page.comment_id || url_for(page.path || ''); %><section class="comments-card" aria-label="<%= px_t('comments') %>" data-comments="<%= c.provider %>" data-server="<%= px_safe_url(c.artalk.server) %>" data-site="<%= c.artalk.site || config.title %>" data-page-key="<%= key %>" data-page-title="<%= page.title || config.title %>" data-artalk-js="<%= px_asset('artalk.js') %>" data-artalk-css="<%= px_asset('artalk.css') %>" data-giscus="<%= JSON.stringify(c.giscus) %>"><h2><%= px_t('comments') %></h2><div class="comment-mount"></div><button class="load-comments"><%= px_t('load_comments') %></button><p class="comment-status" role="status"></p><noscript>JavaScript is required to load comments.</noscript></section><% } %>
