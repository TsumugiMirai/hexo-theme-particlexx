{
  "name": "hexo-theme-particlexx",
  "version": "1.0.0",
  "description": "A fast, accessible Hexo theme continuing the ParticleX visual style, with Artalk comments.",
  "license": "MIT",
  "author": "TsumugiMirai",
  "repository": "github:TsumugiMirai/hexo-theme-particlexx",
  "engines": { "node": ">=22.12.0" },
